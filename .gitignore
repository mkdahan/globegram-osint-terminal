# Secrets & sessions — must NEVER be committed.
# (Real secrets live OUTSIDE the repo in %LOCALAPPDATA%\globegram-terminal\,
#  these patterns are a second safety net in case something leaks in.)
.env
.env.*
!.env.example
secrets.json
settings.local.json
*.session
*.session-journal
session.txt

# Runtime data (media, gazetteer builds, DBs)
data/
media/
*.db
*.db-journal
*.db-wal
*.db-shm
gazetteer.json

# Node
node_modules/
npm-debug.log*
dist/
build/
out/

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# Logs / temp
*.log
tmp/
temp/
.cache/
